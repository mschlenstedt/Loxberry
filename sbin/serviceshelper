#!/bin/bash

# Root helper for system/services.php (sudoers: lbdefaults)
#
#   serviceshelper ssdpd <start|stop|restart>
#   serviceshelper webserver_apply    <port> <sslenabled 0|1> <sslport>
#   serviceshelper webserver_finalize <port> <sslenabled 0|1> <sslport>
#
# The web server ports are applied by sbin/webserverconfig.pl, see there.

isport() {
	[[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

case $1 in
	ssdpd)
		case $2 in
			start|stop|restart) systemctl $2 ssdpd ;;
			*) echo "Usage: $0 ssdpd start|stop|restart"; exit 2 ;;
		esac
		;;
	webserver_apply|webserver_finalize)
		if ! isport "$2" || ! [[ "$3" =~ ^[01]$ ]] || ! isport "$4"; then
			echo "ERROR Wrong parameters"
			exit 2
		fi
		exec "${LBHOMEDIR}/sbin/webserverconfig.pl" "${1#webserver_}" "$2" "$3" "$4"
		;;
	watchdog_logging)
		python3 - "$2" <<'PYTHON'
import re
import shlex
import sys

if len(sys.argv) != 2 or sys.argv[1] not in ("0", "1"):
    sys.exit("watchdog_logging requires 0 or 1")

with open("/etc/default/watchdog", "r+") as config:
    content = config.read()
    pattern = re.compile(r"^[ \t]*watchdog_options[ \t]*=([^\n]*)$", re.MULTILINE)
    matches = list(pattern.finditer(content))
    if len(matches) > 1:
        sys.exit("Multiple watchdog_options assignments in /etc/default/watchdog")
    options = []
    if matches:
        values = shlex.split(matches[0].group(1), comments=True)
        if len(values) > 1:
            sys.exit("Invalid watchdog_options assignment in /etc/default/watchdog")
        options = shlex.split(values[0]) if values else []
    options = [option for option in options
               if option != "--verbose" and not re.fullmatch(r"-v+", option)]
    if sys.argv[1] == "1":
        options.append("-v")
    value = " ".join(shlex.quote(option) for option in options)
    value = re.sub(r'([\\\"$`])', r'\\\1', value)
    assignment = 'watchdog_options="' + value + '"'
    if matches:
        match = matches[0]
        updated = content[:match.start()] + assignment + content[match.end():]
    else:
        updated = content.rstrip("\n") + "\n" + assignment + "\n"
    if updated != content:
        config.seek(0)
        config.write(updated)
        config.truncate()
PYTHON
		exit $?
		;;
	*)
		echo "Usage: $0 ssdpd <start|stop|restart> | webserver_apply|webserver_finalize <port> <sslenabled 0|1> <sslport> | watchdog_logging <0|1>"
		exit 2
		;;
esac
