#!/bin/bash

# Root helper for system/services.php (sudoers: lbdefaults)
#
#   serviceshelper ssdpd <start|stop|restart>
#   serviceshelper webserver_apply    <port> <sslenabled 0|1> <sslport>
#   serviceshelper webserver_finalize <port> <sslenabled 0|1> <sslport>
#
# The web server ports are applied by sbin/webserverconfig.pl, see there.

isport() {
	[[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

case $1 in
	ssdpd)
		case $2 in
			start|stop|restart) systemctl $2 ssdpd ;;
			*) echo "Usage: $0 ssdpd start|stop|restart"; exit 2 ;;
		esac
		;;
	webserver_apply|webserver_finalize)
		if ! isport "$2" || ! [[ "$3" =~ ^[01]$ ]] || ! isport "$4"; then
			echo "ERROR Wrong parameters"
			exit 2
		fi
		exec "${LBHOMEDIR}/sbin/webserverconfig.pl" "${1#webserver_}" "$2" "$3" "$4"
		;;
	*)
		echo "Usage: $0 ssdpd <start|stop|restart> | webserver_apply|webserver_finalize <port> <sslenabled 0|1> <sslport>"
		exit 2
		;;
esac
