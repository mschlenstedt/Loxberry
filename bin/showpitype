#!/bin/sh
# Show the Raspberry Pi model as type_<n>, or "nopi" on non-Pi hardware.
#
# Detection works on 32-bit AND 64-bit kernels. The previous version grepped
# /proc/cpuinfo for "model name : ARMv...", a line that does NOT exist on
# aarch64 (Pi 3/4/5 running a 64-bit OS) - so it wrongly reported "nopi" on
# every modern 64-bit Raspberry. It also had no entry for the Pi 5.
#
# We now detect the Pi via /proc/device-tree/model (present on all Pi models,
# upstream and downstream kernels) with a /proc/cpuinfo fallback, and derive
# the board type from the new-style revision code: bit 23 is the "new format"
# flag, bits 4-11 are the board type.
# https://www.raspberrypi.com/documentation/computers/raspberry-pi.html#raspberry-pi-revision-codes

# --- Is this a Raspberry Pi at all? ---
model=""
[ -r /proc/device-tree/model ] && model="$(tr -d '\000' < /proc/device-tree/model)"
case "$model" in
	*[Rr]aspberry\ [Pp]i*) : ;;
	*)
		if ! grep -qi "raspberry pi" /proc/cpuinfo 2>/dev/null; then
			echo nopi
			exit
		fi
		;;
esac

# --- Board type from the revision code ---
rev="$(awk '/^Revision/ {print $NF; exit}' /proc/cpuinfo)"
if [ -z "$rev" ]; then
	echo unknown
	exit
fi
revnum=$(( 0x$rev ))

if [ $(( (revnum >> 23) & 1 )) -eq 1 ]; then
	# New-style revision code
	type=$(( (revnum >> 4) & 0xFF ))
	case "$type" in
		0|1|2|3|6)      echo type_1 ;;    # A, B, A+, B+, CM1
		4)              echo type_2 ;;    # 2B
		9|12)           echo type_0 ;;    # Zero, Zero W
		18)             echo type_0-2 ;;  # Zero 2 W
		8|10|13|14|16)  echo type_3 ;;    # 3B, CM3, 3B+, 3A+, CM3+
		17|19|20|21)    echo type_4 ;;    # 4B, 400, CM4, CM4S
		23|24|25|26)    echo type_5 ;;    # 5, CM5, 500/500+, CM5 Lite
		*)              echo unknown ;;
	esac
else
	# Old-style revision code (original Pi 1 / early boards)
	echo type_1
fi
